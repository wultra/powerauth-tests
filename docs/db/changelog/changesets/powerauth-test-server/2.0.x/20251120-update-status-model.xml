<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="1" logicalFilePath="powerauth-test-server/2.0.x/20251120-update-status-model.xml" author="Roman Strobl">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="pa_test_status" columnName="shared_secret_algorithm"/>
            </not>
        </preConditions>
        <comment>Create column shared_secret_algorithm in table pa_test_status</comment>
        <addColumn tableName="pa_test_status">
            <column name="shared_secret_algorithm" type="varchar(255)"/>
        </addColumn>
    </changeSet>

    <changeSet id="2" logicalFilePath="powerauth-test-server/2.0.x/20251120-update-status-model.xml" author="Roman Strobl">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="pa_test_status" columnName="temporary_key_act_sign_request_key"/>
            </not>
        </preConditions>
        <comment>Create column temporary_key_act_sign_request_key in table pa_test_status</comment>
        <addColumn tableName="pa_test_status">
            <column name="temporary_key_act_sign_request_key" type="varchar(255)"/>
        </addColumn>
    </changeSet>

    <changeSet id="3" logicalFilePath="powerauth-test-server/2.0.x/20251120-update-status-model.xml" author="Roman Strobl">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="pa_test_status" columnName="pqc_server_public_key"/>
            </not>
        </preConditions>
        <comment>Create column pqc_server_public_key in table pa_test_status</comment>
        <addColumn tableName="pa_test_status">
            <column name="pqc_server_public_key" type="clob"/>
        </addColumn>
    </changeSet>

    <changeSet id="4" logicalFilePath="powerauth-test-server/2.0.x/20251120-update-status-model.xml" author="Roman Strobl">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="pa_test_status" columnName="shared_info2_key"/>
            </not>
        </preConditions>
        <comment>Create column shared_info2_key in table pa_test_status</comment>
        <addColumn tableName="pa_test_status">
            <column name="shared_info2_key" type="varchar(255)"/>
        </addColumn>
    </changeSet>

    <changeSet id="5" logicalFilePath="powerauth-test-server/2.0.x/20251120-update-status-model.xml" author="Roman Strobl">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="pa_test_status" columnName="mac_personalized_data_key"/>
            </not>
        </preConditions>
        <comment>Create column mac_personalized_data_key in table pa_test_status</comment>
        <addColumn tableName="pa_test_status">
            <column name="mac_personalized_data_key" type="varchar(255)"/>
        </addColumn>
    </changeSet>

    <changeSet id="6" author="Roman Strobl">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="pa_test_status" columnName="transport_master_key"/>
        </preConditions>
        <comment>Make transport_master_key nullable in table pa_test_status</comment>
        <dropNotNullConstraint tableName="pa_test_status" columnName="transport_master_key" columnDataType="varchar(255)"/>
    </changeSet>

</databaseChangeLog>
